{
  "task_orchestrator": {
    "max_parallel_tasks": 5,
    "task_timeout_seconds": 300,
    "retry_failed_tasks": true,
    "max_retries": 3,
    "enable_auto_healing": true,
    "enable_visual_testing": true
  },
  "resource_monitoring": {
    "check_interval_seconds": 30,
    "cpu_threshold_percent": 85,
    "memory_threshold_percent": 90,
    "disk_threshold_percent": 95,
    "enable_alerts": true
  },
  "visual_testing": {
    "screenshot_dir": "screenshots",
    "analysis_confidence_threshold": 0.7,
    "auto_retry_on_mismatch": true,
    "max_visual_retries": 2
  },
  "event_listeners": {
    "watch_directories": ["."],
    "watch_extensions": [".py", ".js", ".ts", ".json", ".yaml"],
    "git_events": ["push", "pull", "commit"],
    "enable_file_watcher": true
  },
  "auto_healing": {
    "enable_dependency_auto_fix": true,
    "enable_syntax_auto_fix": true,
    "enable_test_auto_fix": true,
    "knowledge_db_integration": true
  },
  "workflows": [],
  "scheduled_tasks": []
}
